# Clipy — esempio configurazione. Copia in .env (mai committare il vero .env).
CLIPY_HOST=127.0.0.1
CLIPY_PORT=8000
CLIPY_DATA_DIR=./data
# true = avvia scheduler/worker in questo processo
CLIPY_RUN_WORKER=true
# Origini consentite per CORS (frontend dev)
CLIPY_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Segreti: possono essere inseriti da Settings (salvati in DB locale, mai mostrati)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/twitch/callback
BUFFER_API_KEY=
LLM_API_KEY=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# --- STEP 2 (opzionali) ---
# Header Host accettati dall'API (anti DNS-rebinding). Lascia il default: Clipy è pensato per l'uso locale.
# CLIPY_ALLOWED_HOSTS=127.0.0.1,localhost
# Cartella di ffmpeg.exe/ffprobe.exe se non sono nel PATH (Windows)
# CLIPY_FFMPEG_DIR=C:\ffmpeg\bin
# Protezione segreti nel DB: auto (DPAPI su Windows) | dpapi | none
# CLIPY_SECRET_PROTECTION=auto
